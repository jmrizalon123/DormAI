APP_NAME=DormAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dormai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SUPER_ADMIN_EMAIL=admin@dormai.test
SUPER_ADMIN_PASSWORD=password

TENANT_SEED_ORGANIZATION_SLUG=demo-dormitory
TENANT_SEED_ORGANIZATION_EMAIL=demo@dormai.test
TENANT_SEED_OWNER_EMAIL=owner@demo-dorm.test
TENANT_SEED_OWNER_PASSWORD=password

# Public marketplace assistant (local rules + DB). Omit or true; false hides widgets.
# DORMAI_LISTING_ASSISTANT_ENABLED=true

# Optional AI companion (OpenAI-compatible Chat Completions). If unset or disabled, assistant stays local-only.
# DORMAI_LISTING_AI_ENABLED=false
# DORMAI_LISTING_AI_API_KEY=
# DORMAI_LISTING_AI_BASE_URL=https://api.openai.com/v1
# DORMAI_LISTING_AI_MODEL=gpt-4o-mini
# DORMAI_LISTING_AI_TEMPERATURE=0.5
# DORMAI_LISTING_AI_MAX_OUTPUT_TOKENS=600
# DORMAI_LISTING_AI_TIMEOUT=25
# DORMAI_LISTING_AI_MAX_HISTORY_TURNS=6

